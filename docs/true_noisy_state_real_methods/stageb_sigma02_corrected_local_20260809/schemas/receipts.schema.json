{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrected_stageb_receipts_v3.schema.json",
  "title": "Corrected Stage B receipt schemas",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finiteNumber": {"type": "number"},
    "rngReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "process_noise_sigma", "observation_noise_sigma",
        "process_draw_required", "observation_draw_required",
        "process_state_advancement_applicable", "observation_state_advancement_applicable",
        "process_draw_invocations_before", "process_draw_invocations_after",
        "observation_draw_invocations_before", "observation_draw_invocations_after",
        "process_state_before_sha256", "process_state_after_sha256",
        "observation_state_before_sha256", "observation_state_after_sha256"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_rng_receipt_v2"},
        "process_noise_sigma": {"type": "number", "minimum": 0},
        "observation_noise_sigma": {"type": "number", "minimum": 0},
        "process_draw_required": {"type": "boolean"},
        "observation_draw_required": {"type": "boolean"},
        "process_state_advancement_applicable": {"type": "boolean"},
        "observation_state_advancement_applicable": {"type": "boolean"},
        "process_draw_invocations_before": {"type": "integer", "minimum": 0},
        "process_draw_invocations_after": {"type": "integer", "minimum": 0},
        "observation_draw_invocations_before": {"type": "integer", "minimum": 0},
        "observation_draw_invocations_after": {"type": "integer", "minimum": 0},
        "process_state_before_sha256": {"$ref": "#/$defs/sha256"},
        "process_state_after_sha256": {"$ref": "#/$defs/sha256"},
        "observation_state_before_sha256": {"$ref": "#/$defs/sha256"},
        "observation_state_after_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"process_noise_sigma": {"const": 0}}},
          "then": {"properties": {"process_draw_required": {"const": false}, "process_state_advancement_applicable": {"const": false}}},
          "else": {"properties": {"process_draw_required": {"const": true}, "process_state_advancement_applicable": {"const": true}}}
        },
        {
          "if": {"properties": {"observation_noise_sigma": {"const": 0}}},
          "then": {"properties": {"observation_draw_required": {"const": false}, "observation_state_advancement_applicable": {"const": false}}},
          "else": {"properties": {"observation_draw_required": {"const": true}, "observation_state_advancement_applicable": {"const": true}}}
        }
      ]
    },
    "stepEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registration_sha256", "method", "cell", "arm", "episode_id", "timestep", "current_true_abundance", "noisy_observation",
        "selected_action", "benefit_population_term", "action_cost_term",
        "safety_penalty_term", "total_reward", "discount_factor",
        "discounted_benefit_population", "discounted_action_cost",
        "discounted_safety_penalty", "discounted_total_reward",
        "collapse_indicator", "unsafe_indicator", "process_innovation_sha256",
        "observation_innovation_sha256", "rng_receipt"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_step_evidence_v2"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "minLength": 1},
        "arm": {"enum": ["O", "T"]},
        "episode_id": {"type": "integer"},
        "timestep": {"type": "integer", "minimum": 0},
        "current_true_abundance": {"$ref": "#/$defs/finiteNumber"},
        "noisy_observation": {"$ref": "#/$defs/finiteNumber"},
        "selected_action": {"type": "integer", "minimum": 0, "maximum": 10},
        "benefit_population_term": {"$ref": "#/$defs/finiteNumber"},
        "action_cost_term": {"$ref": "#/$defs/finiteNumber"},
        "safety_penalty_term": {"$ref": "#/$defs/finiteNumber"},
        "total_reward": {"$ref": "#/$defs/finiteNumber"},
        "discount_factor": {"$ref": "#/$defs/finiteNumber"},
        "discounted_benefit_population": {"$ref": "#/$defs/finiteNumber"},
        "discounted_action_cost": {"$ref": "#/$defs/finiteNumber"},
        "discounted_safety_penalty": {"$ref": "#/$defs/finiteNumber"},
        "discounted_total_reward": {"$ref": "#/$defs/finiteNumber"},
        "collapse_indicator": {"type": "boolean"},
        "unsafe_indicator": {"type": "boolean"},
        "process_innovation_sha256": {"$ref": "#/$defs/sha256"},
        "observation_innovation_sha256": {"$ref": "#/$defs/sha256"},
        "rng_receipt": {"$ref": "#/$defs/rngReceipt"}
      }
    },
    "exactReturnReconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evidence_layer", "registration_sha256", "method", "cell", "arm",
        "episode_id", "horizon", "gamma", "total_discounted_return", "benefit_contribution",
        "action_cost_contribution", "safety_contribution", "pre_collapse_return",
        "post_collapse_return", "collapse_timing", "collapse_entry_step_partition",
        "discounted_penalty_timing", "unsafe_occupancy_count", "action_sequence",
        "process_rng_final_draw_invocation_count",
        "observation_rng_final_draw_invocation_count", "reconstruction_result"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_exact_return_reconstruction_v2"},
        "evidence_layer": {"const": "EVALUATOR_ONLY"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "minLength": 1},
        "arm": {"enum": ["O", "T"]},
        "episode_id": {"type": "integer"},
        "horizon": {"const": 50},
        "gamma": {"const": 0.95},
        "total_discounted_return": {"type": "number"},
        "benefit_contribution": {"type": "number"},
        "action_cost_contribution": {"type": "number"},
        "safety_contribution": {"type": "number"},
        "pre_collapse_return": {"type": "number"},
        "post_collapse_return": {"type": "number"},
        "collapse_timing": {"type": ["integer", "null"]},
        "collapse_entry_step_partition": {"const": "post-collapse"},
        "discounted_penalty_timing": {"type": "array"},
        "unsafe_occupancy_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "action_sequence": {"type": "array", "minItems": 50, "maxItems": 50},
        "process_rng_final_draw_invocation_count": {"type": "integer", "minimum": 0},
        "observation_rng_final_draw_invocation_count": {"type": "integer", "minimum": 0},
        "reconstruction_result": {"const": "PASS"}
      }
    },
    "pairedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registration_sha256", "method", "cell", "episode_id", "timesteps",
        "process_innovation_sha256", "observation_innovation_sha256",
        "rng_receipt_sha256", "pairing_result"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_paired_evidence_v2"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string", "minLength": 1},
        "cell": {"type": "string", "minLength": 1},
        "episode_id": {"type": "integer"},
        "timesteps": {"type": "array", "minItems": 50, "maxItems": 50},
        "process_innovation_sha256": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/sha256"}},
        "observation_innovation_sha256": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/sha256"}},
        "rng_receipt_sha256": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/sha256"}},
        "pairing_result": {"const": "PASS"}
      }
    },
    "transitionDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registration_sha256", "method", "cell", "arm_o", "arm_t", "raw_O", "raw_T",
        "T_minus_O", "T_over_O_guarded", "aggregate_T_minus_O",
        "aggregate_T_over_O_guarded", "bit_identical"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_transition_diagnostics_v1"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string"}, "cell": {"type": "string"},
        "arm_o": {"type": "object"}, "arm_t": {"type": "object"},
        "raw_O": {"type": "array"}, "raw_T": {"type": "array"},
        "T_minus_O": {"type": "array"}, "T_over_O_guarded": {"type": "array"},
        "aggregate_T_minus_O": {"type": "number"},
        "aggregate_T_over_O_guarded": {"type": "object"},
        "bit_identical": {"type": "boolean"}
      }
    },
    "realizedPosterior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registration_sha256", "method", "cell", "arm", "episode_id", "member_ids", "timesteps", "model_bank_sha256", "posterior_probabilities", "member_count", "initial_entropy", "per_step_entropy",
        "terminal_entropy", "effective_model_count", "registered_sharpness",
        "realized_updates_recorded"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_realized_posterior_v1"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"const": "bamcts"}, "cell": {"type": "string"}, "arm": {"enum": ["O", "T"]},
        "episode_id": {"type": "integer"},
        "member_ids": {"const": [0, 1, 2, 3, 4]},
        "timesteps": {"type": "array", "minItems": 51, "maxItems": 51},
        "model_bank_sha256": {"$ref": "#/$defs/sha256"},
        "posterior_probabilities": {"type": "array", "minItems": 51, "maxItems": 51, "items": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number"}}},
        "member_count": {"const": 5}, "initial_entropy": {"type": "number"},
        "per_step_entropy": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"type": "number"}},
        "terminal_entropy": {"type": "number"},
        "effective_model_count": {"type": "array", "minItems": 51, "maxItems": 51},
        "registered_sharpness": {"type": "array", "minItems": 51, "maxItems": 51},
        "realized_updates_recorded": {"const": true}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "registration_sha256", "method", "cell", "arm", "episode_id", "actions", "sequence_length", "distinct_action_count", "action_counts", "entropy_nats",
        "literal_constant_policy", "near_constant_descriptive", "discrimination_status"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_activity_v1"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string"}, "cell": {"type": "string"}, "arm": {"enum": ["O", "T"]},
        "episode_id": {"type": "integer"}, "sequence_length": {"const": 50},
        "actions": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"type": "integer", "minimum": 0, "maximum": 10}},
        "distinct_action_count": {"type": "integer", "minimum": 1, "maximum": 11},
        "action_counts": {"type": "object"}, "entropy_nats": {"type": "number"},
        "literal_constant_policy": {"type": "boolean"}, "near_constant_descriptive": {"type": "boolean"},
        "near_constant_rule": {"type": "object"}, "maximum_action_fraction": {"type": "number"},
        "discrimination_status": {"type": "string"}
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundTaskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "registration_sha256", "task_index", "arm", "cell", "method", "receipts"],
      "properties": {
        "schema_version": {"const": "corrected_stageb_bound_task_evidence_v2"},
        "kind": {"enum": ["diagnostics", "information_boundary"]},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "task_index": {"type": "integer", "minimum": 0, "maximum": 11},
        "arm": {"const": "O"},
        "cell": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "receipts": {
          "oneOf": [
            {
              "type": "object",
              "required": ["transition", "activity"],
              "additionalProperties": {
                "type": ["object", "array"]
              }
            },
            {
              "type": "object",
              "required": ["runtime_information_boundary"],
              "additionalProperties": false,
              "properties": {"runtime_information_boundary": {"type": "object"}}
            }
          ]
        }
      }
    },
    "artifactBundleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registration_sha256", "task_index", "arm", "cell", "method", "artifact_plan_sha256", "prediction_fixtures", "fixture_row_count", "fixture_manifest_sha256", "components", "component_hashes", "bundle_sha256", "fresh_reload_parity", "frozen_object_artifact", "frozen_object_parity", "frozen_object_binding"],
      "properties": {
        "schema_version": {"const": "corrected_stageb_artifact_bundle_evidence_v4"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "task_index": {"type": "integer", "minimum": 0, "maximum": 11},
        "arm": {"const": "O"},
        "cell": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "artifact_plan_sha256": {"$ref": "#/$defs/sha256"},
        "prediction_fixtures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
          }
        },
        "fixture_row_count": {"const": 3},
        "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/evidenceReference"}
        },
        "component_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_reload_parity": {"const": true},
        "frozen_object_artifact": {"$ref": "#/$defs/evidenceReference"},
        "frozen_object_parity": {"$ref": "#/$defs/evidenceReference"},
        "frozen_object_binding": {"type": "object"}
      }
    },
    "crossProcessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "algorithm", "key_id_sha256", "registration_sha256", "registration_payload_b64", "gate_payload_sha256", "gate_payload_b64", "architecture", "signature_b64"],
      "properties": {
        "schema_version": {"const": "corrected_stageb_cross_process_arm_o_gate_v1"},
        "algorithm": {"const": "Ed25519"},
        "key_id_sha256": {"$ref": "#/$defs/sha256"},
        "registration_sha256": {"$ref": "#/$defs/sha256"},
        "registration_payload_b64": {"type": "string", "contentEncoding": "base64"},
        "gate_payload_sha256": {"$ref": "#/$defs/sha256"},
        "gate_payload_b64": {"type": "string", "contentEncoding": "base64"},
        "architecture": {"const": "Intel Xeon Platinum 8452Y"},
        "signature_b64": {"type": "string", "contentEncoding": "base64"}
      }
    },
    "frozenObjectParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component", "track", "root_class", "serialized_sha256", "operation", "operation_input", "operation_input_sha256", "output_sha256", "post_call_state_sha256", "fresh_object_reload", "complete_instance_graph", "training_history_alone_qualifies", "result"],
      "properties": {
        "schema_version": {"const": "corrected_stageb_frozen_object_parity_v1"},
        "component": {"type": "string", "minLength": 1},
        "track": {"enum": ["general", "ecological"]},
        "root_class": {"type": "string", "pattern": "^real_ecology_benchmark\\."},
        "serialized_sha256": {"$ref": "#/$defs/sha256"},
        "operation": {"enum": ["predict", "act"]},
        "operation_input": {"type": "object", "required": ["args", "kwargs"], "additionalProperties": false},
        "operation_input_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "post_call_state_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_object_reload": {"const": true},
        "complete_instance_graph": {"const": true},
        "training_history_alone_qualifies": {"const": false},
        "result": {"const": "PASS"}
      }
    },
    "parityFailureDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "result", "accepted", "qualifies_as_task_result",
        "automatic_retry_permitted", "task_index", "arm", "cell", "method",
        "current_provenance", "reference_provenance", "eligibility", "comparison",
        "mismatches", "observed_rows_sha256", "reference_rows_sha256", "rng_evidence",
        "information_boundary"
      ],
      "properties": {
        "schema_version": {"const": "corrected_stageb_arm_o_parity_failure_v1"},
        "result": {"const": "FAIL"},
        "accepted": {"const": false},
        "qualifies_as_task_result": {"const": false},
        "automatic_retry_permitted": {"const": false},
        "task_index": {"type": "integer", "minimum": 0, "maximum": 11},
        "arm": {"const": "O"},
        "cell": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "current_provenance": {
          "type": "object", "additionalProperties": false,
          "required": [
            "registration_sha256", "driver_inputs_sha256", "repository_commit",
            "source_manifest_sha256", "stageb_driver_sha256", "rng_contract",
            "interpreter", "fitted_object_sha256", "component_hashes",
            "artifact_plan_sha256", "evaluator"
          ],
          "properties": {
            "registration_sha256": {"$ref": "#/$defs/sha256"},
            "driver_inputs_sha256": {"$ref": "#/$defs/sha256"},
            "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "stageb_driver_sha256": {"$ref": "#/$defs/sha256"},
            "rng_contract": {"type": "object"},
            "interpreter": {"type": "object"},
            "fitted_object_sha256": {"$ref": "#/$defs/sha256"},
            "component_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
            "artifact_plan_sha256": {"$ref": "#/$defs/sha256"},
            "evaluator": {"type": "object"}
          }
        },
        "reference_provenance": {
          "type": "object", "additionalProperties": false,
          "required": [
            "episodes_csv_absolute_path", "episodes_csv_registered_sha256",
            "episodes_csv_observed_sha256", "binding"
          ],
          "properties": {
            "episodes_csv_absolute_path": {"type": "string", "pattern": "^/"},
            "episodes_csv_registered_sha256": {"$ref": "#/$defs/sha256"},
            "episodes_csv_observed_sha256": {"$ref": "#/$defs/sha256"},
            "binding": {"type": "object"}
          }
        },
        "eligibility": {
          "type": "object", "additionalProperties": false,
          "required": [
            "schema_version", "classification", "eligible", "missing_bindings",
            "mismatched_bindings", "result"
          ],
          "properties": {
            "schema_version": {"const": "corrected_stageb_parity_baseline_eligibility_v1"},
            "classification": {"type": "string", "minLength": 1},
            "eligible": {"type": "boolean"},
            "missing_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "mismatched_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "result": {"enum": ["PASS", "FAIL"]}
          }
        },
        "comparison": {
          "type": "object",
          "required": ["stage", "comparison_type", "absolute_tolerance", "result"],
          "properties": {
            "stage": {"enum": ["BASELINE_ELIGIBILITY", "BASELINE_TASK_BINDING", "VALUE_COMPARISON"]},
            "comparison_type": {"type": "string", "minLength": 1},
            "absolute_tolerance": {"const": 1e-9},
            "result": {"const": "FAIL"}
          }
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": [
              "episode", "field_name", "comparison_type", "truth_bearing",
              "observed_canonical_sha256", "reference_canonical_sha256",
              "absolute_delta", "relative_delta", "reason"
            ],
            "properties": {
              "episode": {"type": "integer", "minimum": -1},
              "field_name": {"type": "string", "minLength": 1},
              "comparison_type": {"type": "string", "minLength": 1},
              "truth_bearing": {"type": "boolean"},
              "observed_canonical_sha256": {"$ref": "#/$defs/sha256"},
              "reference_canonical_sha256": {"$ref": "#/$defs/sha256"},
              "absolute_delta": {"type": ["number", "null"]},
              "relative_delta": {"type": ["number", "null"]},
              "reason": {"type": ["string", "null"]}
            }
          }
        },
        "observed_rows_sha256": {"$ref": "#/$defs/sha256"},
        "reference_rows_sha256": {"$ref": "#/$defs/sha256"},
        "rng_evidence": {
          "type": "object", "additionalProperties": false,
          "required": [
            "receipt_schema_version", "rng_contract", "receipt_count",
            "receipts_canonical_sha256", "status"
          ],
          "properties": {
            "receipt_schema_version": {"const": "corrected_stageb_rng_receipt_v2"},
            "rng_contract": {"type": "object"},
            "receipt_count": {"type": "integer", "minimum": 0},
            "receipts_canonical_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["VALIDATED_POST_ROLLOUT", "NOT_CONSTRUCTED"]}
          }
        },
        "information_boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["raw_truth_values_published", "runtime_next_states_published", "truth_trajectory_published", "mismatch_values_hashed"],
          "properties": {
            "raw_truth_values_published": {"const": false},
            "runtime_next_states_published": {"const": false},
            "truth_trajectory_published": {"const": false},
            "mismatch_values_hashed": {"const": true}
          }
        }
      }
    }
  }
}
